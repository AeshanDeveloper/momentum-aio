{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "module": "esnext",               // Changed for clean bundler integration
    "moduleResolution": "bundler",   // Allows path aliases without extensions
    "target": "esnext",
    "types": ["node"],
    "lib": ["esnext", "dom"],         // Next.js needs DOM types for browser compilation
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "strict": false,
    "strictNullChecks": true,
    "noCheck": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@app": ["./src/core/application/Application.ts"],
      "@container": ["./src/core/container/Container.ts"],
      "@config": ["./src/config/index.ts"],
      "@apps/*": ["./src/apps/*"],
      "@config/*": ["./src/config/*"],
      "@core/*": ["./src/core/*"],
      "@database/*": ["./src/database/*"],
      "@discord/*": ["./src/discord/*"],
      "@plugins/*": ["./src/plugins/*"],
      "@sdk/*": ["./src/sdk/*"],
      "@shared/*": ["./src/shared/*"],
      "@tests/*": ["./src/tests/*"],
      "@web/*": ["./src/apps/web/*"],
	  "@bot/*":["./src/apps/bot/*"],
      "@logger": ["./src/core/logging/Logger.ts"]
    }
  },
  "include": [
    "src/config/global.d.ts", 
    "**/*.ts", 
    "**/*.tsx"
  ],
  "exclude": [
    "dist", 
    "node_modules"
  ]
}
