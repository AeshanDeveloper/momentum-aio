# MomentumOne Configuration & Secrets
# Copy this file to .env and fill in your values.

# Discord Bot Credentials (from https://discord.com/developers/applications)
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Bot Settings
BOT_NAME=MomentumOne
BOT_PREFIX=$
BOT_ENABLED=true
ENABLE_ALL_PLUGINS=true

# Security & Ownership
OWNER_IDS=your_discord_user_id_here
BLACKLIST_EXCLUSIONS=
API_SECRET=your_custom_api_secret_key_here

# Database (Leave empty to use high-performance in-memory / local storage)
MONGODB_URI=
MONGODB_DB=momentumone

# Google Gemini Intelligence
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Telemetry & Logging (Optional)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
DISCORD_LOG_WEBHOOK_URL=
LOG_LEVEL=info
NODE_ENV=development
HOST=0.0.0.0
PORT=3000