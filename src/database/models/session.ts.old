import crypto from "crypto";
import db from "@database/Database";

interface SessionRow {
    session_key: string;
    email: string;
    username: string;
    expires_at: Date;
    last_used: Date | null;
    user_id?: string | number;
}

class Session {
    private generateKey(): string {
        return crypto.randomBytes(32).toString("hex");
    }

    async create(
        email: string,
        username: string,
        expiresAt: Date
    ): Promise<string> {
        const key = this.generateKey();

        // Format to YYYY-MM-DD HH:mm:ss (UTC) for MySQL
        const expiresAtD = expiresAt
            .toISOString()
            .slice(0, 19)
            .replace("T", " ");

        await db.query(
            `
            INSERT INTO sessions
            (
                session_key,
                email,
                username,
                expires_at
            )
            VALUES (?, ?, ?, ?)
            `,
            [key, email, username, expiresAtD]
        );

        return key;
    }

    async getByKey(key: string): Promise<SessionRow | null> {
    const rows = await db.query<SessionRow[]>(
        `
        SELECT *
        FROM sessions
        WHERE session_key = ?
        LIMIT 1
        `,
        [key]
    );

    return rows[0] ?? null;
}

    async findByUsername(username: string): Promise<SessionRow[]> {
        const [rows] = await db.query(
            `
            SELECT *
            FROM sessions
            WHERE username = ?
            `,
            [username]
        );

        return rows as SessionRow[];
    }

    async updateLastUsed(key: string): Promise<void> {
        await db.query(
            `
            UPDATE sessions
            SET last_used = NOW()
            WHERE session_key = ?
            `,
            [key]
        );
    }

    async delete(key: string): Promise<void> {
        await db.query(
            `
            DELETE FROM sessions
            WHERE session_key = ?
            `,
            [key]
        );
    }

    async deleteUserSessions(userId: string | number): Promise<void> {
        await db.query(
            `
            DELETE FROM sessions
            WHERE user_id = ?
            `,
            [userId]
        );
    }

    async clearExpired(): Promise<void> {
        await db.query(`
            DELETE FROM sessions
            WHERE expires_at < NOW()
        `);
    }
}

export default new Session();