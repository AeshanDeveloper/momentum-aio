import db from "@database/Database";
import { type RowDataPacket, type ResultSetHeader } from "mysql2";

export interface ProjectData {
    id: string;
    name: string;
    description: string;
    prompt: string;
    status?: string;
    created_at?: Date;
}

export default class Project {
    /**
     * Create a new project.
     */
    static async create(data: ProjectData): Promise<ProjectData> {
        await db.query<ResultSetHeader>(
            `
            INSERT INTO projects
            (
                id,
                name,
                description,
                prompt,
                status
            )
            VALUES (?, ?, ?, ?, ?)
            `,
            [
                data.id,
                data.name,
                data.description,
                data.prompt,
                data.status ?? "created",
            ]
        );

        return data;
    }

    /**
     * Get a project by ID.
     */
    static async find(id: string): Promise<ProjectData | null> {
        const [rows] = await db.query<(ProjectData & RowDataPacket)[]>(
            `
            SELECT *
            FROM projects
            WHERE id = ?
            LIMIT 1
            `,
            [id]
        );

        return rows[0] ?? null;
    }

    /**
     * Get all projects.
     */
    static async all(): Promise<ProjectData[]> {
        const [rows] = await db.query<(ProjectData & RowDataPacket)[]>(
            `
            SELECT *
            FROM projects
            ORDER BY created_at DESC
            `
        );

        return rows;
    }

    /**
     * Update a project's status.
     */
    static async setStatus(id: string, status: string): Promise<void> {
        await db.query<ResultSetHeader>(
            `
            UPDATE projects
            SET status = ?
            WHERE id = ?
            `,
            [status, id]
        );
    }

    /**
     * Update project details.
     */
    static async update(
        id: string,
        data: Pick<ProjectData, "name" | "description" | "prompt">
    ): Promise<void> {
        await db.query<ResultSetHeader>(
            `
            UPDATE projects
            SET
                name = ?,
                description = ?,
                prompt = ?
            WHERE id = ?
            `,
            [
                data.name,
                data.description,
                data.prompt,
                id,
            ]
        );
    }

    /**
     * Delete a project.
     */
    static async delete(id: string): Promise<void> {
        await db.query<ResultSetHeader>(
            `
            DELETE FROM projects
            WHERE id = ?
            `,
            [id]
        );
    }
}