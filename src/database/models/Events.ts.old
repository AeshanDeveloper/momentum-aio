import DatabaseManager from "@database/Database";
import type EventRecord from "@shared/types/EventRecord";

export default class eventModel {
	private readonly database;
    constructor() {
		this.database = DatabaseManager;
	}

    async register(event: EventRecord): Promise<void> {
        await this.database.query(
            `
            INSERT INTO shop_events (
                event_id,
                plugin_id,
                name,
                description,
				enabled,
				status,
                checksum,
                registered_by
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            `,
            [
                event.eventId,
                event.pluginId,
                event.name,
                event.description,
				event.enabled,
				event.status,
                event.checksum,
                event.registeredBy,
            ]
        );
    }
	
	async update(id, event: any): Promise<void> {
    	await this.database.query(
        	`
        	UPDATE shop_events
        	SET
				plugin_id = ?,
				name = ?,
            	description = ?,
            	enabled = ?,
            	status = ?,
            	checksum = ?,
            	registered_by = ?
        	WHERE event_id = ?
        	`,
        	[
				event.pluginId,
				event.name,
            	event.description,
            	event.enabled,
            	event.status,
            	event.checksum,
            	event.registeredBy,
            	event.eventId,
        	]
    	);
	}

    async delete(eventId: string): Promise<boolean> {
        const result = await this.database.query(
            `DELETE FROM shop_events WHERE event_id = ?`,
            [eventId]
        );

        return result.affectedRows > 0;
    }

    async unregister(eventId: string): Promise<boolean> {
        return this.delete(eventId);
    }

    async get<K extends keyof EventRecord>(
        field: K,
        value: EventRecord[K]
    ): Promise<EventRecord[]> {
        const rows = await this.database.query(
            `SELECT * FROM shop_events WHERE \`${String(field)}\` = ?`,
            [value]
        );

        return rows as EventRecord[];
    }

    async getAll(): Promise<EventRecord[]> {
        const rows = await this.database.query(
            `SELECT * FROM shop_events`
        );

        return rows as EventRecord[];
    }
	
	async findById(eventId: string): Promise<EventRecord | null> {
    	const [rows] = await this.database.query(
        	"SELECT * FROM shop_events WHERE event_id = ? LIMIT 1",
        	[eventId]
    	);
	
    	const events = rows as EventRecord[];
    	return events.length ? events[0] : null;
	}
	
	async findByPluginId(pluginId: string): Promise<EventRecord[]> {
    	const [rows] = await this.database.query(
        	"SELECT * FROM shop_events WHERE plugin_id = ?",
        	[pluginId]
    	);
		return rows;
    	//return rows as EventRecord[];
	}
	
	async exists(eventId: string): Promise<boolean> {
    	const [rows] = await this.database.query(
        	"SELECT 1 FROM shop_events WHERE event_id = ? LIMIT 1",
        	[eventId]
    	);
	
    	return (rows as any[]).length > 0;
	}
	
	async existsByPluginNameType(pluginId: string, name: string): Promise<boolean> {
    	const [rows] = await this.database.query(
        	`SELECT 1
            FROM shop_events
            WHERE plugin_id = ? AND name = ? AND type = ?
            LIMIT 1`,
        	[pluginId, name, type]
    	);
	
    	return (rows as any[]).length > 0;
	}
	
	async setStatus(eventId: string, status: any): Promise<void> {
    	await this.database.query(
        	`
        	UPDATE shop_events
        	SET status = ?
        	WHERE event_id = ?
        	`,
        	[
            	status,
            	eventId,
        	]
    	);
	}
}