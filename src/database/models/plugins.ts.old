import DatabaseManager from "@database/Database";
import type { RowDataPacket, ResultSetHeader } from "mysql2";
import logger from "@logger";

export interface GetPluginOptions {
    pluginId?: string;
    name?: string;
    author?: string;
    repositoryUrl?: string;
}

export default class PluginModel {
    static async add(data: {
        pluginId: string;
        name: string;
        description?: string;
        version: string;
        author: string;
        source: "unknown" | "mone-registry" | "github" | "local";
		enabled: string;
        installPath?: string;
        checksum?: string;
        repositoryUrl?: string;
        requiredCoreVersion?: string;
    }) {
        const [result] = await DatabaseManager.query<ResultSetHeader>(
            `INSERT INTO shop_plugins
            (
                plugin_id,
                name,
                description,
                version,
                author,
                source,
				enabled,
                install_path,
                checksum,
                repository_url,
                required_momentushop_version
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
            [
                data.pluginId,
                data.name,
                data.description ?? null,
                data.version,
                data.author,
                data.source,
				data.enabled,
                data.installPath ?? null,
                data.checksum ?? null,
                data.repositoryUrl ?? null,
                data.requiredCoreVersion ?? null
            ]
        );

        return result;
    }

    static async get(options: GetPluginOptions) {
        const conditions: string[] = [];
        const values: unknown[] = [];

        if (options.pluginId) {
            conditions.push("plugin_id = ?");
            values.push(options.pluginId);
        }

        if (options.name) {
            conditions.push("name = ?");
            values.push(options.name);
        }

        if (options.author) {
            conditions.push("author = ?");
            values.push(options.author);
        }

        if (options.repositoryUrl) {
            conditions.push("repository_url = ?");
            values.push(options.repositoryUrl);
        }
        if (!conditions.length) {
            logger.error("[DB] At least one search option must be provided.");
        }

        const [rows] = await DatabaseManager.query<RowDataPacket[]>(
            `SELECT * FROM shop_plugins
             WHERE ${conditions.join(" AND ")}
             LIMIT 1`,
            values
        );

		return rows.map(row => ({
        	pluginId: row.plugin_id,
        	name: row.name,
        	description: row.description,
        	version: row.version,
        	author: row.author,
        	source: row.source,
        	installPath: row.install_path,
        	checksum: row.checksum,
        	repositoryUrl: row.repository_url,
        	requiredMomentumOneVersion: row.required_momentushop_version,
        	enabled: Boolean(row.enabled)
    	}));
    }

    static async getAll() {
    	const [rows] = await DatabaseManager.query<RowDataPacket[]>(
        	"SELECT * FROM shop_plugins"
    	);
	
    	if (!rows || rows.length === 0) {
        	return [];
    	}
	
    	return rows.map(row => ({
        	pluginId: row.plugin_id,
        	name: row.name,
        	description: row.description,
        	version: row.version,
        	author: row.author,
        	source: row.source,
        	installPath: row.install_path,
        	checksum: row.checksum,
        	repositoryUrl: row.repository_url,
        	requiredMomentumOneVersion: row.required_momentushop_version,
        	enabled: Boolean(row.enabled == "true")
    	}));
	}

    static async exists(pluginId: string): Promise<boolean> {
        return (await this.get({ pluginId })) !== null;
    }

    static async update(
    	pluginId: string,
    	data: Record<string, unknown>
	): Promise<boolean> {
    	const columnMap: Record<string, string> = {
        	pluginId: "plugin_id",
        	installPath: "install_path",
        	repositoryUrl: "repository_url",
        	requiredMomentumOneVersion: "required_momentushop_version"
    	};
	
    	const entries = Object.entries(data)
        	.filter(([, value]) => value !== undefined)
        	.map(([key, value]) => [
            	columnMap[key] ?? key,
            	value
        	] as const);
	
    	if (entries.length === 0) {
        	throw new Error("No fields were provided to update.");
    	}
	
    	const fields = entries.map(([column]) => `${column} = ?`).join(", ");
    	const values = entries.map(([, value]) => value);
	
    	values.push(pluginId);
	
    	const [result] = await DatabaseManager.query<ResultSetHeader>(
        	`UPDATE shop_plugins
            SET ${fields}
            WHERE plugin_id = ?`,
        	values
    	);
	
    	return result.affectedRows > 0;
	}

    static async remove(pluginId: string) {
        await DatabaseManager.query(
            "DELETE FROM shop_plugins WHERE plugin_id = ?",
            [pluginId]
        );
    }

    static async setEnabled(pluginId: string, enabled: boolean) {
        await DatabaseManager.query(
            "UPDATE shop_plugins SET enabled = ? WHERE plugin_id = ?",
            [enabled, pluginId]
        );
    }

    static async isEnabled(pluginId: string): Promise<boolean> {
        const plugin = await this.get({ pluginId });
        return plugin?.enabled ?? false;
    }

    static async count(): Promise<number> {
        const [rows] = await DatabaseManager.query<RowDataPacket[]>(
            "SELECT COUNT(*) AS count FROM shop_plugins"
        );

        return rows[0].count;
    }

    static async countEnabled(): Promise<number> {
        const [rows] = await DatabaseManager.query<RowDataPacket[]>(
            "SELECT COUNT(*) AS count FROM shop_plugins WHERE enabled = TRUE"
        );

        return rows[0].count;
    }

    static async countDisabled(): Promise<number> {
        const [rows] = await DatabaseManager.query<RowDataPacket[]>(
            "SELECT COUNT(*) AS count FROM shop_plugins WHERE enabled = FALSE"
        );

        return rows[0].count;
    }
}