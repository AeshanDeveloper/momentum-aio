# Bot Settings
BOT_TOKEN=YOUR-DISCORD-TOKEN
CLIENT_ID=YOUR-CLIENT-ID

# Controls
WEB_ENABLED=false # Including API
BOT_ENABLED=true
PLUGINS_ENABLED=true

# Dashboard
API_BASE_URL=/api/v1
SESSION_SECRET=YOUR-SESSION SECRET
SESSION_MAX_AGE=86400 
LONG_SESSION_EXPIRES_MS=86400000


# DEBUG MODE
DEBUG_MODE=false


# Database Configuration
DB_HOST=HOST
DB_PORT=PORT
DB_NAME=DBNAME
DB_USER=USERNAME
DB_PASSWORD=PASS
DB_SSL_REQUIRED=true
DB_CA_CERTIFICATE=certificates/ca.pem


# Logging Configuration
LOG_LEVEL=silly
LOG_FORMAT=combined

# Special Modifiers
ENABLE_ALL_COMMANDS=true
ENABLE_ALL_PLUGINS=true